include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = AkonadiCalendar
moduleheader = akonadicalendar_qdocmoduleheader.h
description = Akonadi Calendar library.


documentationinheaders = true

headers += \
    akonadicalendar_qdocmoduleheader.h \
    calendarbase.h \
    calendarclipboard.h \
    calendarutils.h \
    calfilterpartstatusproxymodel.h \
    calfilterproxymodel.h \
    collectioncalendar.h \
    core/blockalarmsattribute.h \
    core/freebusyproviderbase.h \
    etmcalendar.h \
    fetchjobcalendar.h \
    freebusymanager.h \
    history.h \
    icalimporter.h \
    incidencechanger.h \
    incidencetreemodel.h \
    itiphandler.h \
    publishdialog.h \
    searchcollectionhelper.h \
    selectcollection.h \
    standardcalendaractionmanager.h \
    todomodel.h \
    todopurger.h
sourcedirs += .

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "AkonadiCalendar"

qhp.projects            = AkonadiCalendar

qhp.AkonadiCalendar.file                = akonadicalendar.qhp
qhp.AkonadiCalendar.namespace           = org.kde.akonadicalendar.$QT_VERSION_TAG
qhp.AkonadiCalendar.virtualFolder       = akonadicalendar
qhp.AkonadiCalendar.indexTitle          = AkonadiCalendar
qhp.AkonadiCalendar.indexRoot           =

qhp.AkonadiCalendar.subprojects         = classes
qhp.AkonadiCalendar.subprojects.classes.title = C++ Classes
qhp.AkonadiCalendar.subprojects.classes.indexTitle = AkonadiCalendar C++ Classes
qhp.AkonadiCalendar.subprojects.classes.selectors = class fake:headerfile
qhp.AkonadiCalendar.subprojects.classes.sortPages = true

tagfile = akonadicalendar.tags
